    return '<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>' + resetCss() + "</style></head><body>" +
      "<title>" + esc(document.title) + "</title>\n" +
      '<link rel="preconnect" href="https://fonts.googleapis.com">\n<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n' +
      '<link id="app-fonts" href="' + esc(fonts) + '" rel="stylesheet">\n' +
      '<style id="app-css">' + document.getElementById("app-css").textContent + "</style>\n\n" +
      '<div id="app"></div>\n\n' +
      '<script type="application/json" id="trip-data">' + data + "<\/script>\n\n" +
      '<script id="app-js">' + document.getElementById("app-js").textContent + "<\/script></body></html>";
  }

  function changed(ops) {
    (ops || []).forEach(function (o) { if (!o.tripId) o.tripId = state.id; });
    render();
    if (mode === "sheet") { lsSet(LS_LOCAL, JSON.stringify(all)); queueOps(ops || []); return; }
    if (mode === "local") { lsSet(LS_LOCAL, JSON.stringify(all)); setStatus("Saved on this device", "saved"); return; }
    if (mode !== "shared") return;
    dirty = true;
    setStatus("Unsaved changes…", "saving");
    clearTimeout(saveTimer);
    saveTimer = setTimeout(save, 2500);
  }

  function save() {
    if (!dirty || saving || mode !== "shared") return;
    saving = true;
    setStatus("Saving…", "saving");
    document.getElementById("app").classList.add("busy");
    artifactApi.publish(buildDocument()).then(function () {
      dirty = false; setStatus("Saved", "saved"); // the view reloads to the new version
    }, function (err) {
      saving = false;
      document.getElementById("app").classList.remove("busy");
      var code = err && err.code;
      if (code === "conflict") { setStatus("Someone saved first. Reloading…", "saving"); return; }
      if (code === "not_writer" || code === "not_granted" || code === "consent_required" || code === "capability_disabled" || code === "not_declared") {
        mode = "readonly"; render(); return;
      }
      if (code === "rate_limited") { setStatus("Saving shortly…", "saving"); saveTimer = setTimeout(save, 8000); return; }
      setStatus("Couldn't save. Retrying…", "saving");
      saveTimer = setTimeout(save, 3000 + Math.random() * 2000);
    });
  }

  var statusText = "", statusClass = "";
  function setStatus(t, c) {
    statusText = t; statusClass = c || "";
    var el = document.getElementById("status");
    if (el) { el.textContent = t; el.className = "status " + statusClass; }
  }

  /* ---------- rendering ---------- */
  function render() {
    var app = document.getElementById("app");
    var focusId = document.activeElement && document.activeElement.id;
    var formVals = {};
    ["f-desc","f-amt","f-paid","f-date","new-person","nt-name","trip-name"].forEach(function (id) { var el = document.getElementById(id); if (el) formVals[id] = el.value; });

    var b = balances();
    var transfers = settle(b);
    var ro = mode === "readonly";
    app.className = "wrap" + (ro ? " readonly" : "");
    if (me && !person(me)) me = "";

    var h = "";
    // trip tabs
    h += '<nav class="tabs" aria-label="Trips"><div class="tab-row">';
    all.trips.slice().reverse().forEach(function (t) {
      var on = t.id === state.id;
      h += '<button type="button" class="tab' + (on ? " on" : "") + '" data-act="tab" data-id="' + esc(t.id) + '"' + (on ? ' aria-current="page"' : "") + ">" + esc(t.trip) + "</button>";
    });
    h += '<button type="button" class="tab add edit-only" data-act="newtrip"' + (newTripOpen ? ' aria-expanded="true"' : "") + ">+ New trip</button></div></nav>";
    if (newTripOpen) {
      h += '<form class="panel new-trip edit-only" id="trip-form"><h2>New trip</h2>';
      h += '<div><label class="label" for="nt-name">Trip name</label><input id="nt-name" type="text" placeholder="e.g. Gili weekend" required></div>';
      if (state.people.length) h += '<label class="check"><input id="nt-copy" type="checkbox" checked> Same people as ' + esc(state.trip) + " (" + state.people.map(function (p) { return esc(p.name); }).join(", ") + ")</label>";
      h += '<div class="form-actions"><button type="button" class="btn ghost" data-act="newtrip">Cancel</button><button type="submit" class="btn">Create trip</button></div></form>';
    }
    // header
    h += '<header class="top"><div style="min-width:0;flex:1">';
    h += '<p class="eyebrow">Split the bill</p>';
    if (renaming && !ro) {
      h += '<form id="rename-form" class="rename-form"><input class="trip-name" id="trip-name" type="text" value="' + esc(state.trip) + '" aria-label="Trip name" maxlength="40" required>';
      h += '<div class="rename-actions"><button type="submit" class="btn small">Save name</button><button type="button" class="btn ghost small" data-act="rename-cancel">Cancel</button></div></form>';
    } else {
      h += '<div class="title-row"><h1 class="trip-title">' + esc(state.trip) + '</h1><button type="button" class="rename-btn edit-only" data-act="rename" aria-label="Rename ' + esc(state.trip) + '">✎ Rename</button></div>';
    }
    h += '</div><div class="top-right">';
    h += '<span id="status" class="status ' + statusClass + '">' + esc(statusText) + "</span>";
    h += "</div></header>";

    if (ro) h += '<div class="ro-note">You\'re viewing this trip. Only the person who made it can add expenses. Pick your name below to see what you owe.</div>';

    if (!state.people.length) {
      h += '<section class="panel"><h2>Who\'s on the trip?</h2><p class="hint">Add everyone first, then log each bill with who paid and who shared it. The page works out the fewest transfers to settle up.</p>';
      h += peopleEditor();
      h += "</section>";
    } else {
      // who am I + settle up
      h += '<section class="panel"><div class="panel-head"><h2>Settle up</h2>';
      h += '<button class="btn ghost small" data-act="copy">Copy summary</button></div>';
      h += '<div class="me-row"><span>I am</span><div class="chips">';
      state.people.forEach(function (p) {
        h += '<button class="chip' + (me === p.id ? " on" : "") + '" data-act="me" data-id="' + p.id + '"><span class="dot" style="--c:var(--' + p.color + ')">' + esc(initials(p.name)) + "</span>" + esc(p.name) + "</button>";
      });
      h += "</div></div>";

      if (me) {
        var mine = transfers.filter(function (t) { return t.from === me || t.to === me; });
        var net = b[me] ? b[me].net : 0;
        var cls = net < -0.005 ? "owe" : net > 0.005 ? "get" : "";
        h += '<div class="you-card ' + cls + '">';
        if (!mine.length) h += '<div class="big">You\'re all square</div>';
        else if (net < 0) h += '<div class="big">You pay ' + fmt(net) + " in total</div>";
        else h += '<div class="big">You get back ' + fmt(net) + " in total</div>";
        mine.forEach(function (t) {
          h += '<div class="hint">' + (t.from === me ? "Pay <b>" + esc(pname(t.to)) + "</b> " : "<b>" + esc(pname(t.from)) + "</b> pays you ") + '<span class="money">' + fmt(t.amt) + "</span></div>";
        });
        h += "</div>";
      }

      if (!transfers.length) {
        h += '<div class="done-note">' + (state.expenses.length ? "Everyone is settled up." : "No bills yet. Add the first one below.") + "</div>";
      } else {
        h += '<div class="transfers">';
        transfers.forEach(function (t, i) {
          var isMine = me && (t.from === me || t.to === me);
          h += '<div class="transfer' + (isMine ? " mine" : "") + '"><div class="who">' + chipHtml(t.from) + '<span class="arrow">pays →</span>' + chipHtml(t.to) + "</div>";
          h += '<span class="amt">' + fmt(t.amt) + "</span>";
          h += '<button class="btn ghost small edit-only" data-act="paid" data-i="' + i + '" title="Record this transfer as paid">Mark paid</button></div>';
        });
        h += "</div>";
      }
      h += "</section>";

      // add / edit expense
      h += '<section class="panel edit-only" id="form-panel"><h2>' + (editingId ? "Edit bill" : "Add a bill") + "</h2>";
      h += '<form id="exp-form" class="form-grid" autocomplete="off">';
      h += '<div><label class="label" for="f-desc">What for</label><input id="f-desc" type="text" placeholder="Dinner, scooter rental, groceries" required></div>';
      h += '<div><label class="label" for="f-amt">Amount (Rp)</label><input id="f-amt" class="formula" type="text" inputmode="decimal" placeholder="e.g. 250000 or 75000*3+50000" required></div>';
      h += '<div><label class="label" for="f-paid">Paid by</label><select id="f-paid">';
      state.people.forEach(function (p) { h += '<option value="' + p.id + '">' + esc(p.name) + "</option>"; });
      h += '</select></div><div><label class="label" for="f-date">Date</label><input id="f-date" type="date"></div>';
      h += '<div class="full"><div class="split-head"><span class="label">Split equally between</span><button type="button" class="linkish" data-act="all">' + (formSplit && formSplit.length === state.people.length ? "Clear" : "Everyone") + "</button></div><div class=\"chips\">";
      if (!formSplit) formSplit = state.people.map(function (p) { return p.id; });
      state.people.forEach(function (p) {
        var on = formSplit.indexOf(p.id) >= 0;
        h += '<button type="button" class="chip ' + (on ? "on" : "off") + '" data-act="split" data-id="' + p.id + '" aria-pressed="' + on + '"><span class="dot" style="--c:var(--' + p.color + ')">' + esc(initials(p.name)) + "</span>" + esc(p.name) + "</button>";
      });
      h += '</div><div class="each" id="each"></div></div>';
      h += '<p class="inline-msg full" id="form-msg" hidden></p>';
      h += '<div class="form-actions full">' + (editingId ? '<button type="button" class="btn ghost" data-act="cancel">Cancel</button>' : "") + '<button type="submit" class="btn">' + (editingId ? "Update bill" : "Add bill") + "</button></div>";
      h += "</form></section>";

      // balances
      h += '<section class="panel"><div class="panel-head"><h2>Who paid what</h2></div><div class="tbl-wrap"><table><thead><tr><th>Person</th><th>Paid (Rp)</th><th>Share (Rp)</th><th>Balance (Rp)</th></tr></thead><tbody>';
      var totPaid = 0;
      state.people.forEach(function (p) {
        var x = b[p.id]; totPaid += x.paid;
        h += '<tr><td><span class="pname"><span class="dot" style="--c:var(--' + p.color + ')"></span>' + esc(p.name) + "</span></td><td>" + num(x.paid) + "</td><td>" + num(x.share) + '</td><td class="' + (x.net > 0.005 ? "pos" : x.net < -0.005 ? "neg" : "") + '">' + (x.net > 0.005 ? "+" : x.net < -0.005 ? "−" : "") + num(x.net) + "</td></tr>";
      });
      h += "</tbody><tfoot><tr><td>Trip total</td><td>" + num(totPaid) + "</td><td></td><td></td></tr></tfoot></table></div>";
      h += '<p class="hint">+ means they get money back, − means they owe. Transfers marked as paid are already counted.</p>';
      h += '<div class="edit-only" style="display:flex;flex-direction:column;gap:10px;border-top:1px solid var(--line);padding-top:14px"><span class="label" style="margin:0">People on the trip</span>' + peopleEditor() + "</div>";
      h += "</section>";

      // list
      h += '<section class="panel"><div class="panel-head"><h2>Bills</h2><span class="hint">' + state.expenses.filter(function (e) { return e.kind !== "payment"; }).length + " logged</span></div>";
      if (!state.expenses.length) h += '<div class="empty">Nothing logged yet.</div>';
      else {
        h += '<div class="exp-list">';
        var sorted = state.expenses.slice().sort(function (a, c) { return (c.date || "").localeCompare(a.date || "") || (c.ts || 0) - (a.ts || 0); });
        var lastDay = null;
        sorted.forEach(function (e) {
          if (e.date !== lastDay) { lastDay = e.date; h += '<div class="day">' + esc(dayLabel(e.date)) + "</div>"; }
          var pay = e.kind === "payment";
          var split = (e.split || []).filter(person);
          var meta = pay ? "Settlement" : "Paid by " + esc(pname(e.paidBy)) + " · " + (split.length === state.people.length ? "split by everyone" : "split by " + split.map(pname).map(esc).join(", ")) + (split.length ? " · " + fmt(e.amount / split.length) + " each" : "");
          h += '<div class="exp' + (pay ? " payment" : "") + (editingId === e.id ? " editing" : "") + '"><span class="bar" style="--c:' + pcolor(e.paidBy) + '"></span>';
          h += '<div style="min-width:0"><div class="desc">' + (pay ? esc(pname(e.paidBy)) + " paid " + esc(pname(split[0])) : esc(e.desc)) + '</div><div class="meta">' + meta + "</div></div>";
          h += '<span class="amt">' + fmt(e.amount) + "</span>";
          h += '<span class="acts edit-only">' + (pay ? "" : '<button class="x" data-act="edit" data-id="' + e.id + '" title="Edit" aria-label="Edit">✎</button>') + '<button class="x" data-act="del" data-id="' + e.id + '" title="Delete" aria-label="Delete">✕</button></span></div>';
        });
        h += "</div>";
      }
      h += "</section>";
    }

    h += '<footer class="foot"><span>' + (mode === "sheet" ? "Synced with your Google Sheet. Friends with the link see and add to the same trips." : mode === "shared" ? "Changes save to this page, so anyone with the link sees the latest numbers." : mode === "readonly" ? "Numbers update when the trip owner saves." : "Saved in this browser only.") + "</span><span>All amounts in IDR · sums like 75000*3 work</span></footer>";
    if (all.trips.length > 1) {
      h += '<div class="del-trip edit-only">' + (confirmDelete
        ? '<span>Delete ' + esc(state.trip) + ' and all its bills?</span><button type="button" class="btn ghost small" data-act="deltrip-no">Keep it</button><button type="button" class="btn small danger" data-act="deltrip-yes">Delete trip</button>'
        : '<button type="button" class="linkish muted" data-act="deltrip">Delete this trip</button>') + "</div>";
    }
    if (mode === "sheet") h += sheetPanel();

    app.innerHTML = h;

    // restore form
    Object.keys(formVals).forEach(function (id) { var el = document.getElementById(id); if (el && formVals[id] != null) el.value = formVals[id]; });
    var dateEl = document.getElementById("f-date");
    if (dateEl && !dateEl.value) dateEl.value = today();
    var paidEl = document.getElementById("f-paid");
    if (paidEl && !formVals["f-paid"] && me) paidEl.value = me;
    if (paidEl && !paidEl.value && state.people[0]) paidEl.value = state.people[0].id;
    updateEach();
    if (focusId) { var f = document.getElementById(focusId); if (f && f.focus) f.focus(); }
  }

  function peopleEditor() {
    var h = '<div class="people-edit">';
    state.people.forEach(function (p) {
      h += '<span class="chip"><span class="dot" style="--c:var(--' + p.color + ')">' + esc(initials(p.name)) + "</span>" + esc(p.name) + '<button class="x" data-act="rmp" data-id="' + p.id + '" aria-label="Remove ' + esc(p.name) + '">✕</button></span>';
    });
    h += '</div><form class="add-person" id="person-form"><input id="new-person" type="text" placeholder="Name, e.g. Sam" aria-label="Name"><button class="btn" type="submit">Add person</button></form>';
    h += '<p class="inline-msg" id="person-msg" hidden></p>';
    return h;
  }

  function today() { var d = new Date(); return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
  function dayLabel(iso) {
    if (!iso) return "No date";
    var d = new Date(iso + "T12:00:00");
    return isNaN(d) ? iso : d.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" });
  }
  function updateEach() {
    var el = document.getElementById("each"); if (!el) return;
    var amt = evalFormula((document.getElementById("f-amt") || {}).value);
    var n = formSplit ? formSplit.length : 0;
    el.textContent = !n ? "Pick at least one person." : isNaN(amt) ? n + (n === 1 ? " person" : " people") : fmt(amt / n) + " each for " + n + (n === 1 ? " person" : " people");
  }
  function showMsg(id, text) { var el = document.getElementById(id); if (el) { el.textContent = text; el.hidden = !text; } }

  /* ---------- events ---------- */
  var app = document.getElementById("app");

  app.addEventListener("click", function (ev) {
    var t = ev.target.closest("[data-act]"); if (!t) return;
    var act = t.getAttribute("data-act"), id = t.getAttribute("data-id");
    if (act === "me") { me = me === id ? "" : id; lsSet(meKey(), me); render(); return; }
    if (act === "tab") {
      // tapping the trip you're already on opens rename
      if (id === state.id && mode !== "readonly") { startRename(); return; }
      newTripOpen = false; renaming = false; pick(id); render(); window.scrollTo(0, 0); return;
    }
    if (act === "rename") { startRename(); return; }
    if (act === "rename-cancel") { renaming = false; render(); return; }
    if (act === "copy") { copySummary(t); return; }
    if (mode === "readonly") return;
    if (act === "split") {
      var i = formSplit.indexOf(id); if (i >= 0) formSplit.splice(i, 1); else formSplit.push(id);
      render(); return;
    }
    if (act === "all") { formSplit = formSplit.length === state.people.length ? [] : state.people.map(function (p) { return p.id; }); render(); return; }
    if (act === "newtrip") { newTripOpen = !newTripOpen; render(); var nt = document.getElementById("nt-name"); if (nt) nt.focus(); return; }
    if (act === "deltrip") { confirmDelete = true; render(); return; }
    if (act === "deltrip-no") { confirmDelete = false; render(); return; }
    if (act === "deltrip-yes") {
      var gone = state.id;
      all.trips = all.trips.filter(function (t) { return t.id !== gone; });
      state = null; currentId = ""; pick();
      changed([{ type: "deleteTrip", tripId: gone }]);
      return;
    }
    if (act === "cancel") { editingId = null; formSplit = null; clearForm(); render(); return; }
    if (act === "edit") {
      var e = state.expenses.filter(function (x) { return x.id === id; })[0]; if (!e) return;
      editingId = id; formSplit = (e.split || []).slice();
      render();
      document.getElementById("f-desc").value = e.desc; document.getElementById("f-amt").value = e.amount;
      document.getElementById("f-paid").value = e.paidBy; document.getElementById("f-date").value = e.date || today();
      updateEach();
      document.getElementById("form-panel").scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }
    if (act === "del") { state.expenses = state.expenses.filter(function (x) { return x.id !== id; }); if (editingId === id) { editingId = null; formSplit = null; } changed([{ type: "deleteExpense", id: id }]); return; }
    if (act === "paid") {
      var tr = settle(balances())[+t.getAttribute("data-i")]; if (!tr) return;
      var payRec = { id: uid(), kind: "payment", desc: "Settlement", amount: tr.amt, paidBy: tr.from, split: [tr.to], date: today(), ts: Date.now() };
      state.expenses.push(payRec);
      changed([{ type: "upsertExpense", expense: payRec }]); return;
    }
    if (act === "rmp") {
      var used = state.expenses.some(function (x) { return x.paidBy === id || (x.split || []).indexOf(id) >= 0; });
      if (used) { showMsg("person-msg", pname(id) + " is part of some bills. Remove or edit those bills first."); return; }
      state.people = state.people.filter(function (p) { return p.id !== id; });
      if (formSplit) formSplit = formSplit.filter(function (x) { return x !== id; });
      changed([{ type: "deletePerson", id: id }]); return;
    }
  });

  app.addEventListener("submit", function (ev) {
    ev.preventDefault();
    if (mode === "readonly") return;
    if (ev.target.id === "rename-form") {
      var nv = document.getElementById("trip-name").value.trim();
      renaming = false;
      if (nv && nv !== state.trip) { state.trip = nv; changed([{ type: "setTrip", tripId: state.id, trip: nv }]); }
      else render();
      return;
    }
    if (ev.target.id === "trip-form") {
      var tname = document.getElementById("nt-name").value.trim();
      if (!tname) return;
      var copy = document.getElementById("nt-copy");
      var t = { id: "t" + uid(), trip: tname, created: Date.now(), people: [], expenses: [] };
      if (copy && copy.checked) t.people = state.people.map(function (p) { return { id: uid(), name: p.name, color: p.color }; });
      all.trips.push(t);
      document.getElementById("nt-name").value = "";
      newTripOpen = false;
      pick(t.id);
      var tops = [{ type: "createTrip", tripId: t.id, trip: { id: t.id, name: t.trip, created: t.created } }];
      t.people.forEach(function (p) { tops.push({ type: "upsertPerson", tripId: t.id, person: p }); });
      changed(tops);
      window.scrollTo(0, 0);
      return;
    }
    if (ev.target.id === "person-form") {
      var inp = document.getElementById("new-person"); var name = inp.value.trim();
      if (!name) return;
      if (state.people.some(function (p) { return p.name.toLowerCase() === name.toLowerCase(); })) { showMsg("person-msg", name + " is already on the list."); return; }
      var used = state.people.map(function (p) { return p.color; });
      var color = PALETTE.filter(function (c) { return used.indexOf(c) < 0; })[0] || PALETTE[state.people.length % PALETTE.length];
      var p = { id: uid(), name: name, color: color };
      state.people.push(p);
      if (formSplit) formSplit.push(p.id);
      inp.value = "";
      changed([{ type: "upsertPerson", person: p }]);
      var again = document.getElementById("new-person"); if (again) { again.value = ""; again.focus(); }
      return;
    }
    if (ev.target.id === "exp-form") {
      var desc = document.getElementById("f-desc").value.trim();
      var amtEl = document.getElementById("f-amt");
      var amt = round2(evalFormula(amtEl.value));
      if (!desc) { showMsg("form-msg", "Add a short description."); return; }
      if (isNaN(amt) || amt <= 0) { amtEl.classList.add("err"); showMsg("form-msg", "Enter the amount as a number or a sum like 450*3+200."); return; }
      if (!formSplit.length) { showMsg("form-msg", "Pick at least one person to split with."); return; }
      var rec = { desc: desc, amount: amt, paidBy: document.getElementById("f-paid").value, split: formSplit.slice(), date: document.getElementById("f-date").value || today(), kind: "expense" };
      var saved;
      if (editingId) {
        state.expenses = state.expenses.map(function (x) { if (x.id === editingId) { saved = Object.assign({}, x, rec); return saved; } return x; });
        editingId = null;
      } else {
        rec.id = uid(); rec.ts = Date.now(); state.expenses.push(rec); saved = rec;
      }
      var keepPaid = rec.paidBy, keepDate = rec.date;
      formSplit = null; clearForm();
      changed(saved ? [{ type: "upsertExpense", expense: saved }] : []);
      document.getElementById("f-paid").value = keepPaid; document.getElementById("f-date").value = keepDate;
      document.getElementById("f-desc").focus();
    }
  });

  function clearForm() { ["f-desc","f-amt"].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ""; }); }

  app.addEventListener("input", function (ev) {
    if (ev.target.id === "f-amt") { ev.target.classList.remove("err"); updateEach(); }
  });
  app.addEventListener("change", function (ev) {
    if (mode === "readonly") return;
    if (ev.target.id === "f-amt") { var n = evalFormula(ev.target.value); if (!isNaN(n) && /[+\-*/()]/.test(ev.target.value)) ev.target.value = round2(n); updateEach(); }
  });
  app.addEventListener("focusin", function (ev) { if (ev.target.id === "f-amt") ev.target.select(); });

  function copySummary(btn) {
    var b = balances(), tr = settle(b);
    var lines = [state.trip + " · settle up"];
    if (!tr.length) lines.push("Everyone is settled up.");
    tr.forEach(function (t) { lines.push("• " + pname(t.from) + " pays " + pname(t.to) + " " + fmt(t.amt)); });
    var total = state.people.reduce(function (s, p) { return s + b[p.id].paid; }, 0);
    lines.push("Trip total " + fmt(total));
    var text = lines.join("\n");
    function ok() { btn.textContent = "Copied"; setTimeout(function () { btn.textContent = "Copy summary"; }, 1600); }
    try {
      navigator.clipboard.writeText(text).then(ok, function () { fallback(text); ok(); });
    } catch (e) { fallback(text); ok(); }
  }
  function fallback(text) {
    var ta = document.createElement("textarea"); ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
    document.body.appendChild(ta); ta.select(); try { document.execCommand("copy"); } catch (e) {} ta.remove();
  }

  /* ---------- Google Sheet sync (standalone file only) ---------- */
  var sheetLink = lsGet("splitbill_sheet_link") || "", sheetError = "";

  function hasTrip(a) { return a.trips.some(function (t) { return t.people.length || t.expenses.length; }); }

  function sheetPanel() {
    var h = '<details class="panel sheet-panel" id="sheet-panel"' + (sheetOpen ? " open" : "") + '><summary><span>Google Sheet</span><span class="hint">' + (sheetError ? "Problem" : "Connected") + "</span></summary>";
    h += '<p class="hint">Every bill saves to the trip\'s Google Sheet, and the page checks for friends\' changes every 30 seconds. Anyone who opens this page shares the same trip.</p>';
    if (sheetError) h += '<p class="inline-msg">' + esc(sheetError) + "</p>";
    h += '<div class="form-actions" style="justify-content:flex-start">';
    if (sheetLink) h += '<a class="btn ghost small" href="' + esc(sheetLink) + '" target="_blank" rel="noopener">Open the sheet</a>';
    h += '<button type="button" class="btn ghost small" data-act="upload">Send this phone\'s bills to the sheet</button>';
    h += '<button type="button" class="btn ghost small" data-act="sync">Refresh now</button>';
    h += '<button type="button" class="btn ghost small" data-act="invite">Copy link for friends</button></div>';
    return h + "</details>";
  }

  function jsonp(url, timeoutMs) {
    return new Promise(function (resolve, reject) {
      var cb = "__splitbill_" + Math.random().toString(36).slice(2);
      var tag = document.createElement("script");
      var timer = setTimeout(function () { done(); reject(new Error("The sheet didn't answer in time.")); }, timeoutMs || 20000);
      function done() { clearTimeout(timer); delete window[cb]; tag.remove(); }
      window[cb] = function (data) { done(); resolve(data); };
      tag.onerror = function () { done(); reject(new Error("Couldn't reach the sheet. Check the Web app access is set to Anyone.")); };
      tag.src = url + (url.indexOf("?") >= 0 ? "&" : "?") + "callback=" + cb + "&t=" + Date.now();
      document.head.appendChild(tag);
    });
  }

  function sheetFailed(err) {
    sheetError = (err && err.message) || String(err);
    setStatus(navigator.onLine === false ? "Offline · showing last copy" : "Sheet problem · see below", "saving");
    render();
  }

  function gotSheetInfo(res) {
    if (res.sheet && res.sheet !== sheetLink) { sheetLink = res.sheet; lsSet("splitbill_sheet_link", sheetLink); }
    if (sheetError) { sheetError = ""; render(); }
  }

  var lastSheetJson = "";
  app.addEventListener("toggle", function (ev) { if (ev.target.id === "sheet-panel") sheetOpen = ev.target.open; }, true);

  function pullSheet(force) {
    if (outbox.length && !force) return Promise.resolve();
    return jsonp(sheetUrl).then(function (res) {
      if (!res || !res.ok) throw new Error("The sheet replied with an error: " + ((res && res.error) || "unknown"));
      gotSheetInfo(res);
      if (outbox.length) return; // this phone's edits are still on their way
      var incoming = normalize(res.state);
      if (!hasTrip(incoming) && hasTrip(all)) {
        // The sheet is empty but this phone already has a trip: send it up, never wipe it.
        uploadAll();
        return;
      }
      var js = JSON.stringify(res.state);
      if (js !== lastSheetJson) {
        lastSheetJson = js;
        all = incoming;
        pick();
        lsSet(LS_LOCAL, JSON.stringify(all));
        render();
      }
      setStatus("Synced", "saved");
    }).catch(sheetFailed);
  }

  function uploadAll() {
    var ops = [];
    all.trips.forEach(function (t) {
      ops.push({ type: "createTrip", trip: { id: t.id, name: t.trip, created: t.created } });
      t.people.forEach(function (p) { ops.push({ type: "upsertPerson", tripId: t.id, person: p }); });
      t.expenses.forEach(function (x) { ops.push({ type: "upsertExpense", tripId: t.id, expense: x }); });
    });
    queueOps(ops); // upserts by id, so sending twice never duplicates
  }

  function queueOps(ops) {
    if (!ops.length) return;
    outbox = outbox.concat(ops);
    lsSet(LS_OUTBOX, JSON.stringify(outbox));
    flushOutbox();
  }

  // Send queued changes in small batches over JSONP, so each one is confirmed by the sheet.
  function nextBatch() {
    var batch = [];
    for (var i = 0; i < outbox.length; i++) {
      var trial = batch.concat([outbox[i]]);
      if (batch.length && encodeURIComponent(JSON.stringify(trial)).length > 1500) break;
      batch = trial;
    }
    return batch;
  }

  var flushing = false, retryTimer = null;
  function flushOutbox() {
    if (flushing || !outbox.length) return;
    flushing = true;
    var batch = nextBatch();
    setStatus("Saving to sheet… " + outbox.length + " left", "saving");
    jsonp(sheetUrl + "?action=write&ops=" + encodeURIComponent(JSON.stringify(batch))).then(function (res) {
      if (!res || !res.ok) throw new Error("The sheet refused the change: " + ((res && res.error) || "unknown"));
      gotSheetInfo(res);
      outbox = outbox.slice(batch.length);
      lsSet(LS_OUTBOX, JSON.stringify(outbox));
      flushing = false;
      if (outbox.length) flushOutbox();
      else { setStatus("Saved to sheet", "saved"); setTimeout(function () { pullSheet(); }, 1500); }
    }).catch(function (err) {
      flushing = false;
      sheetFailed(err);
      setStatus(outbox.length + " change" + (outbox.length === 1 ? "" : "s") + " waiting to save", "saving");
      clearTimeout(retryTimer);
      retryTimer = setTimeout(flushOutbox, 20000);
    });
  }

  function goSheet() {
    mode = "sheet";
    if (local) { try { all = normalize(JSON.parse(local)); pick(); } catch (e) {} }
    setStatus("Connecting…", "saving");
    render();
    if (outbox.length) flushOutbox(); else pullSheet();
    setInterval(function () { if (!document.hidden) { if (outbox.length) flushOutbox(); else pullSheet(); } }, 30000);
    document.addEventListener("visibilitychange", function () { if (!document.hidden) pullSheet(); });
    window.addEventListener("online", flushOutbox);
  }

  app.addEventListener("click", function (ev) {
    var t = ev.target.closest("[data-act]"); if (!t) return;
    var act = t.getAttribute("data-act");
    if (act === "sync") { if (outbox.length) flushOutbox(); else pullSheet(true); }
    if (act === "upload") { uploadAll(); t.textContent = "Sending…"; }
    if (act === "invite") {
      var link = location.href.split("?")[0].split("#")[0];
      var done = function () { t.textContent = "Link copied"; setTimeout(function () { t.textContent = "Copy link for friends"; }, 1600); };
      try { navigator.clipboard.writeText(link).then(done, function () { fallback(link); done(); }); } catch (e) { fallback(link); done(); }
    }
  });

  /* ---------- boot ---------- */
  var local = lsGet(LS_LOCAL);
  setStatus("Loading…", "");
  render();

  function goLocal() {
    mode = "local";
    if (local) { try { all = normalize(JSON.parse(local)); pick(); } catch (e) {} }
    setStatus("Saved on this device", "saved");
    render();
  }

  // Opened directly (or in a plain preview frame): use the Google Sheet.
  // Only inside a Claude artifact, which can't reach Google, does the page save itself instead.
  var tries = 0;
  if (!embedded) { goSheet(); return; }
  (function waitForHost() {
    if (window.claude && typeof window.claude.use === "function") connect();
    else if (++tries < 15) setTimeout(waitForHost, 100);
    else goSheet();
  })();

  function connect() {
    Promise.all([
      window.claude.use("artifact").catch(function () { return null; }),
      window.claude.use("user").catch(function () { return null; })
    ]).then(function (res) {
      artifactApi = res[0];
      var user = res[1];
      if (!artifactApi) { goLocal(); return; }
      var canEdit = user && user.canEdit ? user.canEdit().catch(function () { return true; }) : Promise.resolve(true);
      canEdit.then(function (ok) {
        mode = ok ? "shared" : "readonly";
        setStatus(ok ? "Saved" : "View only", ok ? "saved" : "");
        render();
      });
    });
  }
})();
</script>

</body>
</html>
