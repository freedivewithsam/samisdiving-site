  .form-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; align-items: center; }
  .split-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .linkish { background: none; border: none; color: var(--accent); font-size: 0.78rem; font-weight: 600; padding: 0; }
  .each { font-size: 0.8rem; color: var(--ink-soft); margin-top: 8px; }

  /* expense list */
  .exp-list { display: flex; flex-direction: column; }
  .exp { display: grid; grid-template-columns: 4px minmax(0,1fr) auto auto; gap: 12px; align-items: center; padding: 11px 4px; border-bottom: 1px solid var(--line); }
  .exp:last-child { border-bottom: none; }
  .exp .bar { align-self: stretch; border-radius: 4px; background: var(--c); }
  .exp .desc { font-weight: 600; font-size: 0.95rem; overflow-wrap: anywhere; }
  .exp .meta { font-size: 0.78rem; color: var(--ink-faint); overflow-wrap: anywhere; }
  .exp .amt { font-family: "JetBrains Mono", monospace; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .exp.payment .desc { color: var(--good); font-weight: 500; }
  .exp .acts { display: flex; gap: 2px; }
  .exp.editing { background: var(--surface-2); border-radius: 10px; }
  .day { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); font-weight: 600; padding: 14px 4px 4px; }
  .day:first-child { padding-top: 0; }

  .empty { text-align: center; color: var(--ink-faint); font-size: 0.88rem; padding: 22px 10px; border: 1px dashed var(--line); border-radius: 14px; }
  .ro-note { font-size: 0.8rem; color: var(--ink-soft); background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; }
  footer.foot { color: var(--ink-faint); font-size: 0.78rem; border-top: 1px solid var(--line); padding-top: 14px; display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .sheet-panel summary { cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 10px; font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 1.05rem; list-style: none; }
  .sheet-panel summary::-webkit-details-marker { display: none; }
  .sheet-panel summary::before { content: "▸"; color: var(--accent); margin-right: 8px; font-size: 0.9rem; }
  .sheet-panel[open] summary::before { content: "▾"; }
  .sheet-panel summary > span:first-child { flex: 1; }
  .sheet-panel code { font-family: "JetBrains Mono", monospace; font-size: 0.85em; background: var(--surface-2); border: 1px solid var(--line); border-radius: 5px; padding: 0 5px; }
  .sheet-panel[open] { gap: 12px; }
  .tabs { margin-bottom: -6px; }
  .tab-row { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .tab { flex: none; background: transparent; border: 1px solid var(--line); color: var(--ink-soft); border-radius: 999px; padding: 7px 14px; font-size: 0.84rem; font-weight: 600; white-space: nowrap; }
  .tab:hover { color: var(--ink); border-color: var(--accent); }
  .tab.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .tab.add { border-style: dashed; color: var(--accent); }
  .new-trip { gap: 12px; }
  .check { display: flex; gap: 8px; align-items: flex-start; font-size: 0.86rem; color: var(--ink-soft); }
  .check input { margin-top: 4px; accent-color: var(--accent); }
  .del-trip { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: flex-end; font-size: 0.84rem; color: var(--ink-soft); }
  .linkish.muted { color: var(--ink-faint); font-weight: 500; }
  .linkish.muted:hover { color: var(--warn); }
  .btn.danger { background: var(--warn); color: var(--surface); }
  .readonly .edit-only { display: none !important; }
  .busy { pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

