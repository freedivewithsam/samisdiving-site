      var x = b[id];
      x.net = round2(x.paid + x.sent - x.share - x.received); // + means others owe them
    });
    return b;
  }

  function settle(b) {
    var cred = [], debt = [];
    Object.keys(b).forEach(function (id) {
      if (b[id].net > 0.005) cred.push({ id: id, amt: b[id].net });
      else if (b[id].net < -0.005) debt.push({ id: id, amt: -b[id].net });
    });
