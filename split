  }

  /* balances */
  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  td, th { white-space: nowrap; }
  @media (max-width: 520px) { td { font-size: 0.78rem; padding: 9px 5px; } th { padding: 0 5px 8px; } }
  th { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); font-weight: 600; text-align: right; padding: 0 8px 8px; border-bottom: 1px solid var(--line); }
  th:first-child, td:first-child { text-align: left; }
  td { padding: 9px 8px; text-align: right; font-family: "JetBrains Mono", monospace; font-variant-numeric: tabular-nums; font-size: 0.9rem; border-bottom: 1px solid var(--line); }
  td:first-child { font-family: "Space Grotesk", sans-serif; font-weight: 600; }
  tr:last-child td { border-bottom: none; }
  td.pos { color: var(--good); } td.neg { color: var(--warn); }
  tfoot td { font-weight: 600; border-top: 1px solid var(--line); }
  .pname { display: inline-flex; align-items: center; gap: 8px; }
  .pname .dot { width: 10px; height: 10px; border-radius: 3px; background: var(--c); flex: none; }

  .add-person { display: flex; gap: 8px; }
  .add-person input { flex: 1; min-width: 0; }
  .people-edit { display: flex; flex-wrap: wrap; gap: 8px; }
  .people-edit .chip { padding-right: 4px; }
  .inline-msg { font-size: 0.8rem; color: var(--warn); margin: 0; }

  /* form */
  .form-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 12px; }
