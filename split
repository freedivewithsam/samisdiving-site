  }

  /* ---------- the maths ---------- */
  function balances() {
    var b = {};
    state.people.forEach(function (p) { b[p.id] = { paid: 0, share: 0, sent: 0, received: 0 }; });
    state.expenses.forEach(function (e) {
      var split = (e.split || []).filter(function (id) { return b[id]; });
      if (!b[e.paidBy] || !split.length) return;
      if (e.kind === "payment") {
        b[e.paidBy].sent += e.amount;
        b[split[0]].received += e.amount;
      } else {
        b[e.paidBy].paid += e.amount;
        var each = e.amount / split.length;
        split.forEach(function (id) { b[id].share += each; });
      }
    });
