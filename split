  .chip { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); border-radius: 999px; padding: 5px 12px 5px 6px; font-size: 0.86rem; font-weight: 500; }
  .chip .dot { width: 20px; height: 20px; border-radius: 50%; background: var(--c); display: inline-grid; place-items: center; font-size: 0.66rem; font-weight: 700; color: var(--ink); }
  button.chip:hover { border-color: var(--accent); }
  .chip.on { background: var(--surface); border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .chip.off { opacity: 0.5; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

  /* settle */
  .you-card { border-radius: 14px; padding: 14px 16px; background: var(--surface-2); display: flex; flex-direction: column; gap: 6px; }
  .you-card .big { font-family: "Fraunces", serif; font-weight: 600; font-size: 1.25rem; }
  .you-card.owe { background: var(--warn-bg); } .you-card.owe .big { color: var(--warn); }
  .you-card.get { background: var(--good-bg); } .you-card.get .big { color: var(--good); }
  .transfers { display: flex; flex-direction: column; gap: 8px; }
  .transfer { display: grid; grid-template-columns: minmax(0,1fr) auto auto; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; }
  .transfer.mine { border-color: var(--accent); background: var(--surface-2); }
  .transfer .who { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-weight: 500; min-width: 0; }
  .arrow { color: var(--ink-faint); font-size: 0.8rem; }
  .transfer .amt { font-family: "JetBrains Mono", monospace; font-variant-numeric: tabular-nums; font-weight: 500; white-space: nowrap; }
  .done-note { text-align: center; color: var(--good); background: var(--good-bg); border-radius: 12px; padding: 14px; font-weight: 500; }
  @media (max-width: 520px) {
    .transfer { grid-template-columns: 1fr auto; }
